APP_ENV=development
DATABASE_URL=sqlite:///./nutrition_os.db
# Snapshot the database here before each startup (required and absolute in production).
BACKUP_DIR=
BACKUP_KEEP=14
# Serve the built web app (frontend/dist from `npm run build:web`) on the API origin.
WEB_DIST_DIR=
# Sign-in: "local" (development email sessions) or "tailscale" (required in production).
AUTH_MODE=local
# The single owner's Tailscale login email. Required for AUTH_MODE=tailscale or DEV_AUTO_LOGIN.
OWNER_EMAIL=
# Local development only: skip the sign-in screen and act as OWNER_EMAIL. Never in production.
DEV_AUTO_LOGIN=false
USDA_API_KEY=
OPENAI_API_KEY=
# Label scanning model (cheapest current OpenAI model with image input) and reasoning effort.
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
