APP_ENV=development
DATABASE_URL=sqlite:///./nutrition_os.db
# Sign-in: "local" (development email sessions) or "tailscale" (required in production).
AUTH_MODE=local
# The single owner's Tailscale login email. Required for AUTH_MODE=tailscale or DEV_AUTO_LOGIN.
OWNER_EMAIL=
# Local development only: skip the sign-in screen and act as OWNER_EMAIL. Never in production.
DEV_AUTO_LOGIN=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
USDA_API_KEY=
OPENAI_API_KEY=
