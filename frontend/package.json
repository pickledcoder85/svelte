    "@expo-google-fonts/ribeye": "^0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
