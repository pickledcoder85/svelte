# Copy to /etc/relish/relish.env on the server: sudo install -m 600 -o root -g root ...
APP_ENV=production
AUTH_MODE=tailscale
OWNER_EMAIL=you@example.com
DATABASE_URL=sqlite:////var/lib/relish/relish.db
BACKUP_DIR=/var/lib/relish/backups
BACKUP_KEEP=14
# Optional: copy each nightly snapshot to this private Cloud Storage bucket (VM needs the
# Storage "Read Write" access scope; it authenticates as the VM service account, no keys).
BACKUP_GCS_BUCKET=
BACKUP_GCS_KEEP_DAYS=30
WEB_DIST_DIR=/opt/relish/app/frontend/dist
OPENAI_API_KEY=
USDA_API_KEY=
VISION_MODEL=gpt-6-luna
VISION_REASONING_EFFORT=none
